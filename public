<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Instant Landing Page — NuroWorks</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="nlp-header">
    <a class="nlp-logo" href="/">NUROWORKS</a>
  </header>

  <main class="nlp-container">
    <div class="nlp-hero">
      <h1>Instant Landing Page</h1>
      <p>Describe your business in a sentence or two. Get a complete, ready-to-publish landing page in about a minute.</p>
    </div>

    <div class="nlp-card">
      <form id="generate-form">
        <label class="nlp-label" for="businessDescription">What's your business?</label>
        <textarea
          id="businessDescription"
          class="nlp-textarea"
          placeholder="e.g. A mobile dog grooming service that comes to your driveway — no crate, no waiting room, professional groomers."
          required
        ></textarea>
        <p class="nlp-hint">The more specific you are, the better the page turns out. Mention who it's for and what makes it different.</p>
        <button type="submit" class="nlp-button" id="generate-button">Generate My Landing Page</button>
        <div class="nlp-error" id="error-box"></div>
      </form>
    </div>
  </main>

  <script>
    const form = document.getElementById('generate-form');
    const button = document.getElementById('generate-button');
    const errorBox = document.getElementById('error-box');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.classList.remove('visible');
      button.disabled = true;
      button.textContent = 'Generating — this can take up to a minute...';

      const businessDescription = document.getElementById('businessDescription').value.trim();

      try {
        const res = await fetch('/api/generate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ businessDescription }),
        });
        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Something went wrong.');
        }

        window.location.href = `/preview.html?generationId=${encodeURIComponent(data.generationId)}`;
      } catch (err) {
        errorBox.textContent = err.message;
        errorBox.classList.add('visible');
        button.disabled = false;
        button.textContent = 'Generate My Landing Page';
      }
    });
  </script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Landing Page Preview — NuroWorks</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="nlp-header">
    <a class="nlp-logo" href="/">NUROWORKS</a>
  </header>

  <main class="nlp-container" style="max-width: 1000px;">
    <div id="status" class="nlp-status">Loading your preview...</div>
    <div class="nlp-preview-frame-wrap" id="frame-wrap" style="display:none;">
      <iframe id="preview-frame" title="Landing page preview"></iframe>
    </div>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const generationId = params.get('generationId');
    const statusEl = document.getElementById('status');
    const frameWrap = document.getElementById('frame-wrap');
    const frame = document.getElementById('preview-frame');

    async function loadPreview() {
      if (!generationId) {
        statusEl.textContent = 'No generation specified. Go back and generate a page first.';
        return;
      }

      try {
        const res = await fetch(`/api/preview/${encodeURIComponent(generationId)}`);
        const data = await res.json();

        if (!res.ok) {
          statusEl.textContent = data.error || 'Something went wrong loading your preview.';
          return;
        }

        frame.srcdoc = data.previewHtml;
        statusEl.style.display = 'none';
        frameWrap.style.display = 'block';
      } catch (err) {
        statusEl.textContent = 'Something went wrong loading your preview. Please try again.';
      }
    }

    loadPreview();
  </script>
</body>
</html>

/* style.css — shared styles for Instant Landing Page's own site chrome
   (not the generated landing pages, which are fully self-contained). */

:root {
  --navy: #1B1F3B;
  --accent: #5B3FE0;
  --accent-dark: #4b32c2;
  --text-muted: #44475A;
  --border: #E4E1F5;
  --bg-light: #F7F6FC;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background: var(--bg-light);
  color: var(--navy);
}

.nlp-header {
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nlp-logo {
  font-weight: 800;
  letter-spacing: 0.05em;
  color: var(--accent);
  text-decoration: none;
  font-size: 0.95rem;
}

.nlp-container {
  max-width: 720px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}

.nlp-hero {
  text-align: center;
  margin: 2rem 0 2.5rem;
}

.nlp-hero h1 {
  font-size: 2.25rem;
  margin: 0 0 0.75rem;
}

.nlp-hero p {
  color: var(--text-muted);
  font-size: 1.05rem;
  max-width: 34rem;
  margin: 0 auto;
}

.nlp-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1.75rem;
}

.nlp-label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  font-size: 0.9rem;
}

.nlp-textarea {
  width: 100%;
  min-height: 140px;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 0.85rem;
  font-size: 1rem;
  font-family: inherit;
  resize: vertical;
}

.nlp-textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }

.nlp-hint {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}

.nlp-button {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  padding: 0.9rem 1.75rem;
  border-radius: 999px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  margin-top: 1.25rem;
  width: 100%;
}

.nlp-button:hover { background: var(--accent-dark); }
.nlp-button:disabled { opacity: 0.6; cursor: default; }

.nlp-error {
  color: #B3261E;
  background: #FDEDEC;
  border: 1px solid #F5C2C0;
  border-radius: 10px;
  padding: 0.75rem 1rem;
  font-size: 0.9rem;
  margin-top: 1rem;
  display: none;
}

.nlp-error.visible { display: block; }

.nlp-preview-frame-wrap {
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  background: #fff;
}

.nlp-preview-frame-wrap iframe {
  width: 100%;
  height: 80vh;
  border: none;
  display: block;
}

.nlp-status {
  text-align: center;
  padding: 3rem 1rem;
  color: var(--text-muted);
}

.nlp-success-card {
  text-align: center;
  padding: 3rem 2rem;
}

.nlp-success-card h1 { font-size: 1.75rem; margin-bottom: 0.5rem; }
.nlp-success-card p { color: var(--text-muted); margin-bottom: 1.5rem; }

.nlp-download-link {
  display: inline-block;
  background: var(--accent);
  color: #fff;
  padding: 0.9rem 2rem;
  border-radius: 999px;
  font-weight: 600;
  text-decoration: none;
}

.nlp-download-link:hover { background: var(--accent-dark); }

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment Confirmed — NuroWorks</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="nlp-header">
    <a class="nlp-logo" href="/">NUROWORKS</a>
  </header>

  <main class="nlp-container">
    <div class="nlp-card nlp-success-card" id="content">
      <div id="status">
        <h1>Confirming your payment...</h1>
        <p>This only takes a second.</p>
      </div>
    </div>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const sessionId = params.get('session_id');
    const generationId = params.get('generationId');
    const statusEl = document.getElementById('status');

    async function verifyAndReveal() {
      if (!sessionId) {
        statusEl.innerHTML = '<h1>Something went wrong</h1><p>No payment session found. If you were just charged, contact support and we\'ll sort it out.</p>';
        return;
      }

      try {
        const res = await fetch(`/api/verify/${encodeURIComponent(sessionId)}`);
        const data = await res.json();

        if (data.paid && data.generationId) {
          statusEl.innerHTML = `
            <h1>Your page is ready.</h1>
            <p>Download your full landing page as a single HTML file — host it anywhere.</p>
            <a class="nlp-download-link" href="/api/download/${encodeURIComponent(data.generationId)}">Download Landing Page</a>
          `;
        } else {
          statusEl.innerHTML = '<h1>Still confirming...</h1><p>Payment is processing. This page will refresh automatically.</p>';
          setTimeout(verifyAndReveal, 2000);
        }
      } catch (err) {
        statusEl.innerHTML = '<h1>Something went wrong</h1><p>Couldn\'t confirm your payment. Please refresh this page.</p>';
      }
    }

    verifyAndReveal();
  </script>
</body>
</html>
